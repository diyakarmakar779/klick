rules_version = '2';
// All reads and writes go through the Cloud Run API, which enforces consent and privacy rules
// (owner-only memories, mutual-consent connections, visibility-scoped matching).
// Clients get no direct access, so a leaked web config cannot read anyone's data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
