GOOGLE_CLOUD_PROJECT=your-project-id
# Local dev against the emulator:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
AUTH_MODE=dev
JOB_SECRET=change-me
DEMO_MODE=1

# Luma (official MCP server). PUBLIC_API_URL is this API's public https URL; Luma fetches
# $PUBLIC_API_URL/oauth/luma-client.json as our client id. LUMA_CLIENT_ID overrides that URL.
PUBLIC_API_URL=
WEB_URL=
# LUMA_CLIENT_ID=
# LUMA_REDIRECT_URIS=https://your-app.web.app/connect/luma/callback,http://localhost:5173/connect/luma/callback
# Pin the tool after running `npm run luma:inspect`:
# LUMA_EVENTS_TOOL=
# LUMA_EVENTS_TOOL_ARGS=[{"period":"upcoming"},{"period":"past"}]
