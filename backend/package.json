{
  "name": "event-networking-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "emulators": "firebase emulators:start --only firestore --project demo-event-networking",
    "test": "firebase emulators:exec --only firestore --project demo-event-networking \"vitest run\"",
    "test:unit": "vitest run test/unit",
    "luma:inspect": "tsx scripts/luma-inspect.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@google/genai": "^2.29.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fastify": "^5.12.5",
    "firebase-admin": "^13.10.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "firebase-tools": "^15.33.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
